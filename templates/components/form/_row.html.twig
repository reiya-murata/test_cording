{# フォームの項目一列 #}
{% set isConfirm = is_confirm|default(false) %}
<div class="c-form-row{% if isConfirm %} c-form-row--confirm{% endif %}">

  <div class="c-form-row__label">
    {% if label is defined %}<label class="c-form-row__label-text">{{ label }}</label>
    {% else %}{{ form_label(form) }}
    {% endif %}

    {% if (form is defined and form.vars.required) and (required is not defined or required) %}
      <span class="c-form-row__required">*</span>
    {% endif %}
  </div>

  <div class="c-form-row__body js-form-validation__row">

    <div class="c-form-row__elements js-form-validation__elements">
      {% block elements %}
        {% if value is defined %}{{ value|nl2br }}
        {% elseif form is defined %}
          {% if isConfirm %}
            {{ form.vars.value|nl2br }}
          {% else %}
            {% if params is not defined %}{% set params = {} %}{% endif %}
            {{ form_widget(form, params) }}
          {% endif %}
        {% endif %}
      {% endblock %}
    </div>

    <div class="c-form-row__errors js-form-validation__errors">
      {% block errors %}
        {% if form is defined %}{{ form_errors(form) }}{% endif %}
      {% endblock %}
    </div>

  </div>
</div>
